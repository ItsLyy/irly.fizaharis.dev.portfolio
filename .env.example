# Deployment / Base URL
BASE_URL="http://localhost:3000"

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgres://username:password@localhost:5432/database"

# EmailJS Configuration (Contact Form)
NEXT_PUBLIC_EMAILJS_SERVICE_KEY=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_KEY=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""

# Gemini AI Configuration (AI Portfolio Chatbox)
# Optional: Provide your Google Gemini API key to enable live AI reasoning (Gemini 2.5 Flash).
# If omitted, the chatbox operates seamlessly via the centralized offline memory engine.
GEMINI_API_KEY=""

# WhatsApp Notification Bot Configuration
# Provider: "callmebot" (default & 100% free) or "fonnte"
WHATSAPP_PROVIDER="callmebot"
# Your phone number with country code (e.g. 628123456789 for Indonesia)
WHATSAPP_PHONE=""
# CallMeBot API Key: Send "I allow callmebot to send me messages" to +34 623 78 95 95 on WhatsApp
WHATSAPP_BOT_API_KEY=""
# Optional (if using Fonnte instead of CallMeBot):
# FONNTE_TOKEN=""

